
function MergeSort(arr)
    if len(arr) <= 1 then
        return arr
    end
    l := []
    r := []
    nx := len(arr)

    for i in 0 .. nx div 2 do
        push(l, arr[i])
    end

    for i in nx div 2 .. nx do
        push(r, arr[i])
    end

    l := MergeSort(l)
    r := MergeSort(r)

    return Merge(l, r)
end

function Merge(l, r)
  y := []
  il := 0
  ir := 0
  while il < len(l) and ir < len(r) do
    if l[il] < r[ir] then
      push(y, l[il])
      il := il+1
    else
      push(y, r[ir])
      ir := ir+1
    end
  end
  while il < len(l) do
    push(y, l[il])
    il := il+1
  end
  while ir < len(r) do
    push(y, r[ir])
    ir := ir+1
  end
  return y
end

a := [ 18, 47, 87, 16,  6, 82, 32, 35, 16,  1, 39, 32, 64, 28, 65, 45, 23, 88, 84, 94 ]
a := MergeSort(a)